#!/usr/bin/env bash
# youtube-live-translate-host - Executable Launcher for Chrome Native Messaging Host

set -e

# Resolve installation root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Always use this installation's isolated environment.
PYTHON_BIN="$RUNTIME_ROOT/venv/bin/python3"
if [ ! -x "$PYTHON_BIN" ]; then
    echo "ERROR: Runtime virtual environment is missing; rerun install.sh." >&2
    exit 1
fi

export PYTHONPATH="$RUNTIME_ROOT:${PYTHONPATH:-}"

exec "$PYTHON_BIN" "$RUNTIME_ROOT/host/native_messaging_host.py" "$@"
